{
  "name": "m-minecraft-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft Education native and Sandboxie feasibility controller; legacy VMware source retained",
  "engines": {
    "node": "^24.22.0",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "setup": "npm --prefix apps/desktop ci --engine-strict --no-audit --no-fund",
    "dev": "npm --prefix apps/desktop run dev:app",
    "verify:repository": "node tooling/repository/verify.mjs",
    "test": "npm --prefix apps/desktop run test",
    "check:desktop": "npm --prefix apps/desktop run verify:source",
    "check:runtime": "cargo check --locked --all-targets --manifest-path engine/runtime-core/Cargo.toml",
    "test:runtime": "cargo test --locked --all-targets --manifest-path engine/runtime-core/Cargo.toml",
    "format:runtime": "cargo fmt --manifest-path engine/runtime-core/Cargo.toml --all --check",
    "verify:source": "npm run verify:repository -- --g0 && npm run check:structure && npm run check:dependencies && npm run test:repository && npm run test:localtest && npm run test:feasibility && npm run test:isolation-source && npm run test:native-feasibility && npm run test:sandboxie-feasibility && npm run test:native-performance && npm run test:presentmon && npm run check:desktop && npm run check:runtime && npm run test:runtime && npm run format:runtime",
    "package:windows": "npm --prefix apps/desktop run build:app",
    "test:feasibility": "node --test tooling/acceptance/evaluate-client-feasibility.test.mjs",
    "feasibility:review": "node tooling/acceptance/evaluate-client-feasibility.mjs",
    "test:native-feasibility": "node --test tooling/acceptance/evaluate-native-feasibility.test.mjs",
    "native-feasibility:review": "node tooling/acceptance/evaluate-native-feasibility.mjs",
    "test:sandboxie-feasibility": "node --test tooling/acceptance/evaluate-sandboxie-feasibility.test.mjs",
    "test:native-performance": "node --test tooling/acceptance/evaluate-native-performance.test.mjs",
    "native-performance:review": "node tooling/acceptance/evaluate-native-performance.mjs",
    "sandboxie-feasibility:review": "node tooling/acceptance/evaluate-sandboxie-feasibility.mjs",
    "test:localtest": "node --test tooling/local-test/session.test.mjs tooling/windows-toolchain/portable.test.mjs",
    "test:isolation-source": "node --test tooling/isolation-source/validate-baseline.test.mjs tooling/isolation-source/verify-artifact-files.test.mjs tooling/isolation-source/bootstrap-fork.test.mjs tooling/isolation-source/verify-checkout.test.mjs tooling/isolation-source/assemble-engine.test.mjs tooling/isolation-source/provision-disposable.test.mjs tooling/isolation-source/execute-disposable.test.mjs tooling/isolation-source/windows/transport-commands.test.mjs tooling/isolation-source/windows/attestation-gate.test.mjs tooling/isolation-source/windows/service-ownership.test.mjs tooling/isolation-source/windows/ownership-ledger.test.mjs tooling/isolation-source/windows/reconcile-ownership.test.mjs engine/isolation-native/fork-overlay/apply-private-source.test.mjs engine/isolation-native/owned-runtime/minecraft-profiles.test.mjs tooling/isolation-source/assemble-private-engine.test.mjs tooling/isolation-source/import-full-sandboxie.test.mjs tooling/isolation-source/apply-owned-sandboxie.test.mjs tooling/isolation-source/verify-owned-v1186.test.mjs tooling/isolation-source/build-owned-v1186.test.mjs tooling/isolation-source/assemble-owned-v1186.test.mjs tooling/isolation-source/windows/prepare-owned-v1186-test.test.mjs tooling/isolation-source/windows/test-owned-v1186-runtime.test.mjs",
    "isolation-source:verify": "node tooling/isolation-source/verify-owned-v1186.mjs",
    "isolation-source:inspect-candidate": "cargo test --locked --manifest-path apps/desktop/src-tauri/Cargo.toml engine::owned_isolation::tests::actual_staged_owned_payload_remains_not_installable -- --ignored --exact --nocapture",
    "isolation-source:bootstrap": "node tooling/isolation-source/bootstrap-fork.mjs",
    "isolation-source:checkout-verify": "node tooling/isolation-source/verify-checkout.mjs",
    "isolation-source:assemble": "node tooling/isolation-source/assemble-owned-v1186.mjs",
    "isolation-source:plan-disposable": "node tooling/isolation-source/plan-disposable.mjs",
    "isolation-source:simulate-disposable": "node tooling/isolation-source/simulate-disposable.mjs",
    "isolation-source:transport-probe": "powershell -NoProfile -NonInteractive -File tooling/isolation-source/windows/kmdutil-transport.ps1",
    "isolation-source:review-ownership": "node tooling/isolation-source/windows/review-ownership.mjs",
    "isolation-source:reconcile-ownership": "node tooling/isolation-source/windows/reconcile-ownership-cli.mjs",
    "isolation-native:configure": "cmake -S engine/isolation-native -B workspace/isolation-native-build -G \"Visual Studio 17 2022\" -A x64",
    "isolation-native:build": "cmake --build workspace/isolation-native-build --config Release",
    "isolation-native:test": "ctest --test-dir workspace/isolation-native-build -C Release --output-on-failure",
    "isolation-source:assemble-private": "node tooling/isolation-source/assemble-private-engine.mjs",
    "isolation-native:test-owned-start": "cmake -S engine/isolation-native/owned-runtime -B workspace/owned-start-policy -DCMAKE_BUILD_TYPE=Release && cmake --build workspace/owned-start-policy --config Release && ctest --test-dir workspace/owned-start-policy -C Release --output-on-failure",
    "isolation-source:verify-legacy-v1185": "node tooling/isolation-source/validate-baseline.mjs tooling/isolation-source/upstream-baseline.json",
    "test:presentmon": "node --test tooling/acceptance/analyze-presentmon.test.mjs",
    "frametime:review": "node tooling/acceptance/analyze-presentmon.mjs",
    "upgrade:frontend": "node tooling/dependencies/upgrade-frontend.mjs",
    "check:structure": "node tooling/repository/check-structure.mjs",
    "test:repository": "node --test tooling/repository/*.test.mjs tooling/dependencies/*.test.mjs",
    "check:dependencies": "node tooling/repository/check-dependency-lock.mjs",
    "audit:dependencies": "node tooling/dependencies/audit.mjs"
  }
}
