{
  "schemaVersion": 1,
  "package": "M-Minecraft-Emulator Toolchain",
  "target": {
    "developerOs": [
      "Windows 10 x64",
      "Windows 11 x64"
    ],
    "backendOs": [
      "Windows x64 / VMware Workstation",
      "macOS / VMware Fusion (source capability)"
    ],
    "architecture": "x86_64"
  },
  "policy": {
    "nodeVersionPinned": true,
    "npmVersionPinned": true,
    "rustVersionPinned": true,
    "appLockfileRequired": true,
    "ciPolicy": "disabled",
    "endUserToolchainRequired": false,
    "guestOSAndMinecraftExternal": true,
    "localDeveloperStorage": true
  },
  "node": {
    "major": 24,
    "channel": "LTS",
    "version": "24.21.0",
    "scope": [
      "desktop development",
      "repository source verification"
    ]
  },
  "npm": {
    "source": "bundled-with-node",
    "version": "11.19.0",
    "lockfile": "apps/desktop/package-lock.json",
    "installMode": "npm --prefix apps/desktop ci"
  },
  "rust": {
    "version": "1.98.1",
    "components": [
      "rustfmt"
    ],
    "scope": [
      "runtime-core",
      "desktop Tauri backend"
    ]
  },
  "powershell": {
    "minimumMajor": 7,
    "scope": [
      "optional Windows developer launcher",
      "Windows acceptance scripts"
    ],
    "version": "7.5.4"
  },
  "portableWindowsX64": {
    "node": {
      "name": "node-v24.21.0-win-x64.zip",
      "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip",
      "sha256": "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541",
      "directory": "node-v24.21.0-win-x64"
    },
    "powershell": {
      "name": "PowerShell-7.5.4-win-x64.zip",
      "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.5.4/PowerShell-7.5.4-win-x64.zip",
      "sha256": "b40d192ae95ba6ccc4cc362ff4e1b18ca6fb5055bebbcd3920684e12701fa8f6",
      "directory": ""
    },
    "rustup": {
      "url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe",
      "sha256Url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe.sha256"
    }
  }
}
