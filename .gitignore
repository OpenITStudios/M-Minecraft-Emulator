# VM guests and secrets
*.vmdk
*.vmsd
*.vmsn
*.vmem
*.nvram
*.vmss
*.vmxf
*.vmx
*.vmx.lck/
*.vmwarevm/
*.mcworld
*.mctemplate
*.mcpack
*.mcaddon
*.pfx
*.p12
*.pem
*.key
.env
.env.*
!.env.example

# Source outputs
node_modules/
dist/
target/
coverage/
apps/desktop/src-tauri/icons/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/package-resources/
*.log
*.tmp
.DS_Store
Thumbs.db

# Acceptance/telemetry — do not store real machine or account evidence
workspace/evidence/
workspace/captures/
workspace/private/

# VM/storage images and local runtime material
*.vhd
*.vhdx
*.pvm
workspace/images/
workspace/runtime/
workspace/diagnostics/
engine/runtime-core/runtime/
engine/runtime-core/images/
# Machine-local execution materials: never source-control.
# The workspace README is the only intentionally tracked entry.
/workspace/*
!/workspace/README.md

# Prevent accidental second output roots.
/artifacts/
/downloads/
/installers/
/test-results/
/App/
/Data/
/Logs/

# Common accidentally copied root-level binary outputs.
/*.exe
/*.msi
/*.msix
/*.msixbundle
/*.iso
/*.zip
/*.7z
/*.dmp

# Native Svelte/TypeScript checker intermediates
/apps/desktop/.svelte-check/
