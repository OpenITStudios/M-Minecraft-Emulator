{
  "schema": 1,
  "productName": "Lazy Tester",
  "identifier": "com.mivubi.lazytester",
  "mainBinaryName": "lazy-tester",
  "installMode": "currentUser",
  "requiredFiles": [
    "lazy-tester.exe",
    "independent-bootstrap/bootstrap-compat.dll",
    "independent-bootstrap/bootstrap-enroll.dll",
    "distribution/lazy-tester-package.json",
    "en-US/lazy-tester.exe.mui",
    "en-US/Lazy Tester - Sessions.exe.mui",
    "en-US/Lazy Tester - Window Recovery.exe.mui",
    "Lazy Tester - Sessions.exe",
    "Lazy Tester - Window Recovery.exe"
  ],
  "migration": {
    "strategy": "side-by-side-from-preview",
    "previousProductName": "Minecraft Instance Manager Preview",
    "previousIdentifier": "com.mivubi.minecraft.instancemanager.preview",
    "previousBinary": "minecraft-instance-manager-preview.exe",
    "installerMayMigrateData": false,
    "installerMayDeleteData": false,
    "installerMayStopMinecraft": false
  },
  "runtime": {
    "settingsRelativePath": "MinecraftInstanceManager/NativePreview/manager-settings.json",
    "instanceLeaseVariant": "NativePilot",
    "profiles": "product-owned-five-or-reviewed-existing-private-file-identities",
    "profileBindingIncluded": false,
    "profileBindingRelativePath": "MinecraftInstanceManager/NativePreview/profile-binding-five.bin",
    "profileBindingImport": "reviewed-existing-five-only",
    "portableProfileProvisioning": "FIVE_FRESH_STORES_SOURCE_IMPLEMENTED_RUNTIME_NOT_EXECUTED",
    "applicationSubdirectory": "App",
    "defaultDataRelativePath": "Data",
    "dataLocatorRelativePath": "Data/Settings/data-location.json",
    "profileCatalogRelativePath": "Data/profiles.json",
    "newProfileDirectories": "Data/Launchers/Minecraft-1..5",
    "existingDataMigration": "PRESERVE_IN_PLACE",
    "manualRelocation": "SAME_VOLUME_AND_WINDOWS_USER_IDENTITIES_REQUIRED",
    "crossVolumeRelocation": "NOT_IMPLEMENTED",
    "crossBinaryControllerHandoff": "UNSUPPORTED",
    "legacyDataLocatorRelativePath": "App/data-location.json",
    "legacyProfileDirectories": "Data/Profiles/Minecraft-1..5"
  },
  "excludedPayloads": [
    "VMware",
    "Sandboxie",
    "Guest Agent",
    "acceptance tooling",
    "profile capabilities",
    "accounts",
    "tokens",
    "worlds"
  ],
  "release": {
    "publicationEnabled": false,
    "requiresAuthenticodeBeforePublication": true
  }
}
