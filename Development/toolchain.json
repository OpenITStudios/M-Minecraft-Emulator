{
  "schemaVersion": 1,
  "package": "M-Minecraft-Emulator Toolchain",
  "target": {
    "developerOs": [
      "Windows 10 x64",
      "Windows 11 x64"
    ],
    "backendOs": [
      "Windows 10/11 x64 (native Minecraft Education profiles)"
    ],
    "architecture": "x86_64"
  },
  "policy": {
    "nodeVersionPinned": true,
    "npmVersionPinned": true,
    "rustVersionPinned": true,
    "appLockfileRequired": true,
    "ciPolicy": "disabled",
    "endUserToolchainRequired": false,
    "guestOSAndMinecraftExternal": true,
    "localDeveloperStorage": true
  },
  "node": {
    "major": 24,
    "channel": "LTS",
    "version": "24.22.0",
    "scope": [
      "desktop development",
      "repository source verification"
    ]
  },
  "npm": {
    "source": "registry-pinned",
    "version": "12.2.0",
    "lockfile": "apps/desktop/package-lock.json",
    "installMode": "npm --prefix apps/desktop ci"
  },
  "rust": {
    "version": "1.99.1",
    "components": [
      "rustfmt"
    ],
    "scope": [
      "runtime-core",
      "desktop Tauri backend"
    ]
  },
  "powershell": {
    "minimumMajor": 7,
    "scope": [
      "optional Windows developer launcher",
      "Windows acceptance scripts"
    ],
    "version": "7.6.7"
  },
  "portableWindowsX64": {
    "node": {
      "name": "node-v24.22.0-win-x64.zip",
      "url": "https://nodejs.org/dist/v24.22.0/node-v24.22.0-win-x64.zip",
      "sha256": "f9683a19877e12a9b167305c8db71040d812876359de21f0d2e97c3f321f80c3",
      "directory": "node-v24.22.0-win-x64"
    },
    "powershell": {
      "name": "PowerShell-7.6.7-win-x64.zip",
      "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.6.7/PowerShell-7.6.7-win-x64.zip",
      "sha256": "d2f952ebdbf24386cb8923553aa58e41a846db35a6155ea04c58142a4b16dbb7",
      "directory": ""
    },
    "rustup": {
      "url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe",
      "sha256Url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe.sha256"
    }
  }
}
