{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M-Bedrock Virtual Clients",
  "version": "0.1.0",
  "identifier": "com.mivubi.mbedrock.virtualclients",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lazy Tester",
        "width": 1280,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "workspace-events",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-start-dragging",
            "core:window:allow-is-maximized",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-close"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "publisher": "MIVUBI-STD",
    "shortDescription": "Desktop manager for multiple Minecraft Education virtual clients.",
    "longDescription": "M-Bedrock Virtual Clients manages isolated Minecraft Education virtual clients while keeping virtualization, account setup, recovery, and diagnostics under explicit user control.",
    "copyright": "Copyright © MIVUBI-STD",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../engine/guest/windows/": "guest/windows/",
      "../../../tooling/acceptance/windows/": "acceptance/windows/",
      "../../../engine/distribution/release-channel.json": "distribution/release-channel.json",
      "../../../engine/distribution/package-contract.json": "distribution/package-contract.json",
      "../../../engine/distribution/install-lifecycle-policy.json": "distribution/install-lifecycle-policy.json",
      "../../../engine/distribution/test-upgrade.ps1": "distribution/test-upgrade.ps1",
      "../../../engine/distribution/write-payload-manifest.ps1": "distribution/write-payload-manifest.ps1"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "M-Bedrock Virtual Clients",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
