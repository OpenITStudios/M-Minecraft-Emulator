{
  "productName": "Lazy Tester",
  "identifier": "com.mivubi.lazytester",
  "mainBinaryName": "lazy-tester",
  "build": {
    "beforeBundleCommand": "node scripts/prepare-process-roles.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lazy Tester",
        "width": 1280,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "maximized": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "publisher": "MIVUBI-STD",
    "shortDescription": "Control center for five independent Minecraft Education profiles",
    "longDescription": "Lazy Tester provides manual profile launch, a five-session workspace, native previews, persistent profile settings and explicit storage controls. Minecraft Education and licensed accounts are supplied separately.",
    "externalBin": [],
    "resources": {
      "package-resources/lazy-tester/bootstrap-compat.dll": "independent-bootstrap/bootstrap-compat.dll",
      "package-resources/lazy-tester/bootstrap-enroll.dll": "independent-bootstrap/bootstrap-enroll.dll",
      "../../../engine/distribution/lazy-tester-package.json": "distribution/lazy-tester-package.json",
      "package-resources/lazy-tester/en-US/": "en-US/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Lazy Tester",
        "installerHooks": "windows/lazy-tester-hooks.nsh"
      }
    }
  }
}
