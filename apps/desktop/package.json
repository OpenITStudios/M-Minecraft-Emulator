{
  "name": "m-bedrock-virtual-clients-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:frontend": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "dev:app": "npm run prepare:icons && tauri dev",
    "build:frontend": "vite build",
    "preview:frontend": "vite preview",
    "build:app": "npm run prepare:icons && npm run prepare:package-binaries && tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.package.conf.json -- --locked",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "npm run prepare:icons && cargo check --all-targets --locked --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --all-targets --locked --manifest-path src-tauri/Cargo.toml",
    "verify:source": "npm run typecheck && npm run test && npm run build:frontend && npm run check:rust && npm run test:rust",
    "prepare:package-binaries": "node scripts/prepare-package-binaries.mjs",
    "test": "vitest run test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
